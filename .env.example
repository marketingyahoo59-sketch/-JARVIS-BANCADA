# Escolha um provedor: openai | anthropic
LLM_PROVIDER=openai

# OpenAI (visão + Whisper). TTS padrão é edge (rápido, grátis).
OPENAI_API_KEY=sk-...

# Anthropic (Claude) — opcional
ANTHROPIC_API_KEY=sk-ant-...

# Modelos
# Bancada rápida: gpt-4o-mini | Visão forte: gpt-4o
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
WHISPER_MODEL=whisper-1

# Voz: edge (rápido) | openai | off
JARVIS_TTS=edge
TTS_VOICE=nova
TTS_MODEL=gpt-4o-mini-tts

# Pasta local / Cloud Run
JARVIS_DATA_DIR=./data

# Google Cloud Storage (obrigatório em produção no Cloud Run)
# GCS_BUCKET=meu-projeto-jarvis-data
# GCS_PREFIX=jarvis

# GitHub (push)
# GITHUB_TOKEN=ghp_...
