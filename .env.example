# Escolha um provedor: openai | anthropic
LLM_PROVIDER=openai

# OpenAI (GPT-4o visão + Whisper escuta + TTS fala)
OPENAI_API_KEY=sk-...

# Anthropic (Claude 3.5 Sonnet com visão) — opcional
ANTHROPIC_API_KEY=sk-ant-...

# Modelos (opcional)
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
WHISPER_MODEL=whisper-1
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=nova
